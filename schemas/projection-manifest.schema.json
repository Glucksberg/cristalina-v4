{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://cristalina-v4.local/schemas/projection-manifest.schema.json",
  "title": "Cristalina v4 Projection Manifest",
  "allOf": [
    {
      "$ref": "https://cristalina-v4.local/schemas/object-envelope.schema.json"
    },
    {
      "type": "object",
      "required": [
        "kind",
        "layer",
        "authoritative_home",
        "adapter",
        "projection_profile",
        "audience",
        "read_policy_version",
        "compiler_version",
        "context_refs",
        "artifact_refs",
        "upstream_refs"
      ],
      "properties": {
        "kind": {
          "const": "projection_manifest"
        },
        "layer": {
          "const": "derived"
        },
        "authoritative_home": {
          "const": "governance"
        },
        "adapter": {
          "type": "string",
          "enum": [
            "openclaw",
            "hermes"
          ]
        },
        "projection_profile": {
          "type": "string",
          "minLength": 1
        },
        "audience": {
          "type": "string",
          "minLength": 1
        },
        "read_policy_version": {
          "type": "string",
          "minLength": 1
        },
        "compiler_version": {
          "type": "string",
          "minLength": 1
        },
        "actor_identity_ref": {
          "type": [
            "string",
            "null"
          ]
        },
        "owner_identity_ref": {
          "type": [
            "string",
            "null"
          ]
        },
        "runtime_instance_ref": {
          "type": [
            "string",
            "null"
          ]
        },
        "runtime_session_ref": {
          "type": [
            "string",
            "null"
          ]
        },
        "conversation_thread_ref": {
          "type": [
            "string",
            "null"
          ]
        },
        "source_checkpoint_ref": {
          "type": [
            "string",
            "null"
          ]
        },
        "continuity_epoch": {
          "type": [
            "string",
            "null"
          ]
        },
        "generation": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 0
        },
        "policy_snapshot_ref": {
          "type": [
            "string",
            "null"
          ]
        },
        "snapshot_strategy": {
          "type": [
            "string",
            "null"
          ],
          "enum": [
            "mixed_state_tolerant",
            "checkpoint_consistent",
            null
          ]
        },
        "context_refs": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "uniqueItems": true
        },
        "suppressed_refs": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "uniqueItems": true
        },
        "suppressed_records": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "id",
              "kind",
              "reason_code"
            ],
            "properties": {
              "id": {
                "type": "string"
              },
              "kind": {
                "type": "string"
              },
              "reason_code": {
                "type": "string"
              }
            },
            "additionalProperties": true
          }
        },
        "retrieval_trace_refs": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "uniqueItems": true
        },
        "included_retrieval_candidate_refs": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "uniqueItems": true
        },
        "suppressed_retrieval_candidate_refs": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "uniqueItems": true
        },
        "retrieval_traces": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "query_ref",
              "recipe_ref",
              "included_candidate_refs",
              "suppressed_candidate_refs",
              "suppression_reasons"
            ],
            "properties": {
              "trace_ref": {
                "type": "string"
              },
              "query_ref": {
                "type": "string"
              },
              "recipe_ref": {
                "type": "string"
              },
              "included_candidate_refs": {
                "type": "array",
                "items": {
                  "type": "string"
                },
                "uniqueItems": true
              },
              "suppressed_candidate_refs": {
                "type": "array",
                "items": {
                  "type": "string"
                },
                "uniqueItems": true
              },
              "suppression_reasons": {
                "type": "array",
                "items": {
                  "type": "string",
                  "enum": [
                    "visibility_scope_mismatch",
                    "authority_mismatch",
                    "stale_record",
                    "contradicted_record",
                    "unsupported_wiki_claim",
                    "missing_upstream_ref",
                    "projection_budget_exceeded",
                    "invalid_external_candidate",
                    "embedding_generation_mismatch"
                  ]
                },
                "uniqueItems": true
              }
            },
            "additionalProperties": true
          }
        },
        "diagnostic_refs": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "review_refs": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "artifact_refs": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "minItems": 1,
          "uniqueItems": true
        },
        "upstream_refs": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "minItems": 1,
          "uniqueItems": true
        }
      },
      "dependentRequired": {
        "suppressed_records": [
          "suppressed_refs"
        ]
      },
      "additionalProperties": true
    }
  ]
}
