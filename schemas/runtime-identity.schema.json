{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://cristalina-v4.local/schemas/runtime-identity.schema.json",
  "title": "Cristalina v4 Runtime Identity Record",
  "allOf": [
    {
      "$ref": "https://cristalina-v4.local/schemas/object-envelope.schema.json"
    },
    {
      "oneOf": [
        {
          "type": "object",
          "required": [
            "kind",
            "actor_kind",
            "label",
            "status"
          ],
          "properties": {
            "kind": {
              "const": "actor_identity"
            },
            "layer": {
              "const": "canon"
            },
            "authoritative_home": {
              "const": "canon"
            },
            "actor_kind": {
              "type": "string",
              "enum": [
                "owner",
                "agent",
                "external_person",
                "external_organization",
                "system"
              ]
            },
            "label": {
              "type": "string"
            },
            "status": {
              "type": "string",
              "enum": [
                "active",
                "inactive",
                "archived"
              ]
            }
          },
          "additionalProperties": true
        },
        {
          "type": "object",
          "required": [
            "kind",
            "runtime",
            "agent_identity_ref",
            "status"
          ],
          "properties": {
            "kind": {
              "const": "runtime_instance"
            },
            "layer": {
              "const": "runtime"
            },
            "authoritative_home": {
              "const": "runtime"
            },
            "runtime": {
              "type": "string",
              "enum": [
                "openclaw",
                "hermes",
                "generic"
              ]
            },
            "agent_identity_ref": {
              "type": "string"
            },
            "owner_identity_ref": {
              "type": [
                "string",
                "null"
              ]
            },
            "status": {
              "type": "string",
              "enum": [
                "active",
                "paused",
                "closed"
              ]
            }
          },
          "additionalProperties": true
        },
        {
          "type": "object",
          "required": [
            "kind",
            "runtime_instance_ref",
            "status"
          ],
          "properties": {
            "kind": {
              "const": "runtime_session"
            },
            "layer": {
              "const": "runtime"
            },
            "authoritative_home": {
              "const": "runtime"
            },
            "runtime_instance_ref": {
              "type": "string"
            },
            "status": {
              "type": "string",
              "enum": [
                "active",
                "paused",
                "closed"
              ]
            },
            "objective": {
              "type": [
                "string",
                "null"
              ]
            },
            "summary": {
              "type": [
                "string",
                "null"
              ]
            }
          },
          "additionalProperties": true
        },
        {
          "type": "object",
          "required": [
            "kind",
            "runtime_instance_ref",
            "runtime_session_ref",
            "conversation_thread_ref",
            "continuity_epoch",
            "generation",
            "read_policy_version",
            "upstream_refs",
            "status"
          ],
          "properties": {
            "kind": {
              "const": "working_memory_checkpoint"
            },
            "layer": {
              "const": "runtime"
            },
            "authoritative_home": {
              "const": "runtime"
            },
            "runtime_instance_ref": {
              "type": "string",
              "minLength": 1
            },
            "runtime_session_ref": {
              "type": "string",
              "minLength": 1
            },
            "conversation_thread_ref": {
              "type": "string",
              "minLength": 1
            },
            "continuity_epoch": {
              "type": "string",
              "minLength": 1
            },
            "generation": {
              "type": "integer",
              "minimum": 1
            },
            "read_policy_version": {
              "type": "string",
              "minLength": 1
            },
            "upstream_refs": {
              "type": "array",
              "items": {
                "type": "string"
              },
              "minItems": 1,
              "uniqueItems": true
            },
            "summary": {
              "type": [
                "string",
                "null"
              ]
            },
            "status": {
              "type": "string",
              "enum": [
                "active",
                "superseded",
                "invalidated"
              ]
            },
            "supersedes_ref": {
              "type": [
                "string",
                "null"
              ]
            },
            "superseded_by_ref": {
              "type": [
                "string",
                "null"
              ]
            },
            "policy_snapshot_ref": {
              "type": [
                "string",
                "null"
              ]
            }
          },
          "additionalProperties": true
        },
        {
          "type": "object",
          "required": [
            "kind",
            "runtime",
            "runtime_instance_ref",
            "runtime_session_ref",
            "message_refs",
            "summary"
          ],
          "properties": {
            "kind": {
              "const": "conversation_thread"
            },
            "layer": {
              "const": "runtime"
            },
            "authoritative_home": {
              "const": "runtime"
            },
            "runtime": {
              "type": "string",
              "enum": [
                "openclaw",
                "hermes",
                "generic"
              ]
            },
            "runtime_instance_ref": {
              "type": "string"
            },
            "runtime_session_ref": {
              "type": "string"
            },
            "message_refs": {
              "type": "array",
              "items": {
                "type": "string"
              }
            },
            "summary": {
              "type": [
                "string",
                "null"
              ]
            }
          },
          "additionalProperties": true
        }
      ]
    }
  ]
}
