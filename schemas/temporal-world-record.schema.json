                    "bounded",
                    "historical",
                    "unresolved"
                  ]
                },
                "valid_from": {
                  "type": [
                    "string",
                    "null"
                  ],
                  "format": "date-time"
                },
                "valid_to": {
                  "type": [
                    "string",
                    "null"
                  ],
                  "format": "date-time"
                },
