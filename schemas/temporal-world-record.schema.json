                  "type": [
                    "string",
                    "null"
                  ],
                  "format": "date-time"
                },
                "valid_to": {
                  "type": [
                    "string",
                    "null"
                  ],
                  "format": "date-time"
                },
                "temporal_confidence": {
                  "type": [
                    "number",
                    "null"
                  ]
                }
              },
              "additionalProperties": true
