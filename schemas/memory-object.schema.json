{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://cristalina-v4.local/schemas/memory-object.schema.json",
  "title": "Cristalina v4 Canonical Memory Object",
  "allOf": [
    {
      "$ref": "https://cristalina-v4.local/schemas/object-envelope.schema.json"
    },
    {
      "type": "object",
      "required": [
        "layer",
        "authoritative_home",
        "statement",
        "epistemic_state",
        "governance_state",
        "temporal_state"
      ],
      "properties": {
        "layer": {
          "const": "canon"
        },
        "authoritative_home": {
          "const": "canon"
        },
        "kind": {
          "type": "string",
          "enum": [
            "fact",
            "belief",
            "preference",
            "constraint",
            "goal",
            "value",
            "identity_trait"
          ]
        },
        "statement": {
          "type": "string"
        },
        "epistemic_state": {
          "type": "string",
          "enum": [
            "observed",
            "inferred",
            "hypothesized",
            "confirmed",
            "disputed"
          ]
        },
        "governance_state": {
          "type": "string",
          "enum": [
            "ratified",
            "superseded",
            "archived"
          ]
        },
        "temporal_state": {
          "type": "object",
          "required": [
            "temporal_status"
          ],
          "properties": {
            "temporal_status": {
              "type": "string",
              "enum": [
                "active",
                "bounded",
                "historical",
                "unresolved"
              ]
            },
            "valid_from": {
              "type": [
                "string",
                "null"
              ],
              "format": "date-time"
            },
            "valid_to": {
              "type": [
                "string",
                "null"
              ],
              "format": "date-time"
            },
            "temporal_confidence": {
              "type": [
                "number",
                "null"
              ]
            }
          },
          "additionalProperties": true
        },
        "supersedes_ref": {
          "type": [
            "string",
            "null"
          ]
        },
        "superseded_by_ref": {
          "type": [
            "string",
            "null"
          ]
        }
      },
      "additionalProperties": true
    }
  ]
}
