{
  "name": "@cristalina-v4/openclaw-adapter",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "description": "OpenClaw integration for Cristalina v4",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "node ../../scripts/with-core-dist.mjs -- tsc -p tsconfig.json",
    "typecheck": "node ../../scripts/with-core-dist.mjs -- tsc -p tsconfig.json --noEmit",
    "test": "node ../../scripts/with-core-dist.mjs -- pnpm run test:local",
    "test:local": "tsc -p tsconfig.json && node --test dist/**/*.test.js"
  },
  "dependencies": {
    "@cristalina-v4/core": "workspace:*"
  }
}
