{
  "name": "cristalina-v4",
  "private": true,
  "version": "0.0.0",
  "description": "Next-generation governed memory architecture with OpenClaw and Hermes Agent integrations",
  "license": "MIT",
  "author": "Markus Glucksberg",
  "homepage": "https://github.com/Glucksberg/cristalina-v4",
  "repository": {
    "type": "git",
    "url": "https://github.com/Glucksberg/cristalina-v4.git"
  },
  "bugs": {
    "url": "https://github.com/Glucksberg/cristalina-v4/issues"
  },
  "keywords": [
    "memory",
    "agent-memory",
    "knowledge-graph",
    "governed-memory",
    "ai-memory",
    "openclaw",
    "hermes-agent",
    "llm-memory",
    "canonical-memory"
  ],
  "packageManager": "pnpm@10.17.1",
  "scripts": {
    "build": "pnpm -r build",
    "typecheck": "pnpm -r typecheck",
    "smoke:dual-runtime": "pnpm --filter @cristalina-v4/openclaw-adapter build && pnpm --filter @cristalina-v4/hermes-adapter build && node scripts/smoke-dual-runtime.mjs",
    "fixture:mvp-flow-001": "pnpm --filter @cristalina-v4/core build && node packages/core/dist/fixtures/write-mvp-flow-001.js examples/mvp-flow-001/.cristalina-v4",
    "fixture:mvp-flow-002": "pnpm --filter @cristalina-v4/core build && node packages/core/dist/fixtures/write-mvp-flow-002.js examples/mvp-flow-002/.cristalina-v4",
    "fixture:mvp-flow-003": "pnpm --filter @cristalina-v4/core build && node packages/core/dist/fixtures/write-mvp-flow-003.js examples/mvp-flow-003/.cristalina-v4",
    "lint": "echo \"Scaffold lint not configured yet\"",
    "test": "pnpm -r test"
  },
  "devDependencies": {
    "@types/node": "^24.6.0",
    "typescript": "^5.9.2"
  }
}
